# ============================================================
# Tech With Hussain — Production SEO Canonical & Routing
# Hostinger Shared Hosting | Apache
# NON-TRAILING-SLASH canonical URL architecture
# ============================================================

Options -Indexes
ServerSignature Off

# Real prerendered 404 page for missing pages and assets
ErrorDocument 404 /404.html

<IfModule mod_dir.c>
    # Disable Apache's automatic trailing-slash redirect on physical directories
    # Prevents Apache from redirecting /about to /about/
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── 1. UNIFIED 301 REDIRECT (HTTP / WWW → HTTPS NON-WWW) ─────
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://techwithhussain.online%{REQUEST_URI} [R=301,L]

    # ── 2. TARGETED 410 GONE FOR OBSOLETE ENDPOINTS ──────────────
    RewriteRule ^comments(/feed)?/?$ - [G,L,NC]
    RewriteRule ^feed/?$ - [G,L,NC]
    RewriteRule ^refund-policy(\.html)?$ - [G,L,NC]

    # ── 2b. SPECIFIC LEGACY .HTML REDIRECTS TO NON-TRAILING-SLASH ─
    RewriteRule ^(about|contact|projects|services|experience|resume|testimonials|blog|privacy-policy|terms|sitemap|skills)\.html$ https://techwithhussain.online/$1 [R=301,L,NC]

    # ── 2c. SKILLS ALIAS → HOMEPAGE ANCHOR ───────────────────────
    RewriteRule ^skills/?$ https://techwithhussain.online/#skills [R=301,L,NE]

    # ── 2d. LEGACY SERVICE ALIAS 301 REDIRECTS (NON-TRAILING-SLASH) ─
    RewriteRule ^services/wordpress-development/?$ https://techwithhussain.online/services/web-development [R=301,L,NC]
    RewriteRule ^services/ai-development/?$ https://techwithhussain.online/services/application-development [R=301,L,NC]
    RewriteRule ^services/ai-web-development/?$ https://techwithhussain.online/services/application-development [R=301,L,NC]
    RewriteRule ^services/seo-full-project/?$ https://techwithhussain.online/services/seo-services [R=301,L,NC]
    RewriteRule ^services/content-creation/?$ https://techwithhussain.online/services/social-media-marketing [R=301,L,NC]
    RewriteRule ^services/website-optimization/?$ https://techwithhussain.online/services/web-development [R=301,L,NC]

    # ── 3. DIRECT BACKEND API ROUTING ────────────────────────────
    RewriteRule ^api/(.*)$ backend/api/$1 [L,QSA]

    # ── 4. HOMEPAGE & ROOT ASSET EXEMPTIONS ──────────────────────
    RewriteRule ^$ index.html [L]
    RewriteRule ^index\.html$ - [L]

    # ── 5. TRAILING SLASH REMOVAL (NON-ROOT) ─────────────────────
    # Redirect /about/ -> /about (301)
    # NEVER redirect: root /, real files, api
    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api(/|$) [NC]
    RewriteRule ^(.*)/$ https://techwithhussain.online/$1 [R=301,L]

    # ── 6. SERVE PRERENDERED DIRECTORY INDEX (INTERNAL REWRITE) ──
    # Because DirectorySlash is Off, requests for /about won't auto-resolve index.html.
    # Internally serve the directory's index.html without changing the browser URL.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^([^.]+)$ $1/index.html [L]

    # ── 7. SERVE EXISTING STATIC FILES DIRECTLY ──────────────────
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ── 8. UNKNOWN URLS → REAL HTTP 404 (NO SOFT 404) ────────────
    # For any remaining request that does NOT exist as a file or prerendered page:
    # Do NOT rewrite to index.html with HTTP 200.
    # Return genuine HTTP 404 via Apache ErrorDocument.
    RewriteRule ^ - [R=404,L]
</IfModule>

# ── Browser Caching ──────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg          "access plus 1 year"
    ExpiresByType image/png           "access plus 1 year"
    ExpiresByType image/webp          "access plus 1 year"
    ExpiresByType image/gif           "access plus 1 year"
    ExpiresByType image/svg+xml       "access plus 1 year"
    ExpiresByType text/css            "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json    "access plus 0 seconds"
    ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

# ── Compression (Gzip) ───────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
    AddOutputFilterByType DEFLATE application/json text/xml image/svg+xml
    AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ── Security Headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

FileETag MTime Size
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>
