# ============================================================
# Tech With Hussain — Production SEO Canonical & SPA Routing
# Hostinger Shared Hosting | Apache
# ============================================================

Options -Indexes
ServerSignature Off

# Real prerendered 404 page for missing assets
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── 1. UNIFIED 301 REDIRECT (HTTP / WWW → HTTPS NON-WWW) ─────
    # Single 301 hop to https://techwithhussain.online
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://techwithhussain.online%{REQUEST_URI} [R=301,L]

    # ── 2. TARGETED 410 GONE FOR OBSOLETE ENDPOINTS ──────────────
    # Immediately drop legacy feeds and removed static files without hitting SPA 200 fallback
    RewriteRule ^comments(/feed)?/?$ - [G,L,NC]
    RewriteRule ^feed/?$ - [G,L,NC]
    RewriteRule ^refund-policy(\.html)?$ - [G,L,NC]

    # ── 2b. SPECIFIC LEGACY .HTML REDIRECTS TO TRAILING SLASH ────
    RewriteRule ^(about|contact|projects|services|experience|resume|testimonials|blog|privacy-policy|terms|sitemap)\.html$ https://techwithhussain.online/$1/ [R=301,L,NC]

    # ── 3. DIRECT BACKEND API ROUTING ────────────────────────────
    RewriteRule ^api/(.*)$ backend/api/$1 [L,QSA]

    # ── 4. STRICT TRAILING SLASH ENFORCEMENT (NON-ROOT, NON-FILE) ─
    # 301 redirect subpages without trailing slash to trailing-slash format
    # e.g. /about -> /about/, /blog/example -> /blog/example/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/api(/|$) [NC]
    RewriteCond %{REQUEST_URI} !(.*)/+$
    RewriteRule ^(.*)$ https://techwithhussain.online/$1/ [R=301,L]

    # ── 5. SPA FALLBACK ROUTING ──────────────────────────────────
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# ── Browser Caching ──────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg          "access plus 1 year"
    ExpiresByType image/png           "access plus 1 year"
    ExpiresByType image/webp          "access plus 1 year"
    ExpiresByType image/gif           "access plus 1 year"
    ExpiresByType image/svg+xml       "access plus 1 year"
    ExpiresByType text/css            "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json    "access plus 0 seconds"
    ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

# ── Compression (Gzip) ───────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
    AddOutputFilterByType DEFLATE application/json text/xml image/svg+xml
    AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ── Security Headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

FileETag MTime Size
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>
