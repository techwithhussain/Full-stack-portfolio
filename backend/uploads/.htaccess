# Block direct PHP execution in uploads directory (CRITICAL SECURITY)
# Any uploaded file cannot be executed as PHP even if malicious
<Files "*.php">
    Order Deny,Allow
    Deny from all
</Files>
<Files "*.phtml">
    Order Deny,Allow
    Deny from all
</Files>
<Files "*.php5">
    Order Deny,Allow
    Deny from all
</Files>
<FilesMatch "\.(php|phtml|php5|php7|php8|phar)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable directory listing
Options -Indexes
